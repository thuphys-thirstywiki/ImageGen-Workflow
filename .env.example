# OpenAI-compatible API
VAPI_KEY=sk-your-key-here
# Host root or .../v1 both work; missing /v1 is auto-appended
VAPI_BASE=https://api.example.com

# Model names (must exist on your provider / channel group)
IMAGE_MODEL=gemini-3-pro-image
VLM_MODEL=gpt-5

# Optional shared gate for public deploy (leave empty to disable)
ACCESS_CODE=

# Admin password for delete / reset-quota (required for those actions)
ADMIN_PASSWORD=

# Shared API call budgets (defaults: image 30, critique 100)
# IMAGE_QUOTA_LIMIT=30
# CRITIQUE_QUOTA_LIMIT=100

# Optional absolute path for session/image storage (Docker default: /data/sessions)
# DATA_DIR=

# Vercel Blob (cloud). When set, sessions/images are stored in Blob instead of local disk.
# BLOB_READ_WRITE_TOKEN=

